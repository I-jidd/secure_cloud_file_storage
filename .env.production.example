
# --------------------------------------------
# App
# --------------------------------------------
APP_NAME=Secure Cloud Storage API
APP_ENV=production

# --------------------------------------------
# Database
# --------------------------------------------
POSTGRES_USER=securecloud_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=secure_cloud_storage

DATABASE_URL=postgresql://securecloud_user:replace-with-a-strong-database-password@postgres:5432/secure_cloud_storage

# --------------------------------------------
# JWT
# --------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --------------------------------------------
# Storage
# --------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# --------------------------------------------
# Frontend build
# For local Docker testing:
# VITE_API_BASE_URL=http://localhost:8000/api
#
# For production:
# VITE_API_BASE_URL=https://your-api-domain.com/api
# --------------------------------------------
VITE_API_BASE_URL=https://your-api-domain.com/api

# --------------------------------------------
# CORS
# Use your real frontend domain in production.
# Example:
# FRONTEND_ORIGIN=https://your-domain.com
# --------------------------------------------
FRONTEND_ORIGIN=https://your-frontend-domain.com